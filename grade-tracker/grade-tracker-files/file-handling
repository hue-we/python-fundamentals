FILENAME = "students.txt"

def save_students(students):
    with open(FILENAME, "w") as f:
        for name, grades in students.items():
            grades_str = ",".join(str(g) for g in grades)
            f.write(f"{name}:{grades_str}\n")
    print("Saved to file.\n")

def load_students():
    students = {}
    try:
        with open(FILENAME, "r") as f:
            for line in f.readlines():
                line = line.strip()
                if not line:
                    continue
                name, grades_str = line.split(":")
                grades = [int(g) for g in grades_str.split(",")]
                students[name] = grades
    except FileNotFoundError:
        pass
    return students

def add_student(students):
    name = input("Enter student name: ")
    grades_input = input("Enter grades separated by spaces (e.g. 85 90 78): ")
    grades = [int(g) for g in grades_input.split()]
    students[name] = grades
    print(f"Added {name} with grades {grades}\n")

def show_students(students):
    if not students:
        print("No students added yet.\n")
        return
    print("\nAll students:")
    for name, grades in students.items():
        average = sum(grades) / len(grades)
        print(f"{name}: {grades} -> average {average:.1f}")
    print()

students = load_students()
print("Grade Tracker (now with saving)")
print("Commands: add, view, save, quit\n")

while True:
    command = input("What do you want to do? ").lower()

    if command == "add":
        add_student(students)
    elif command == "view":
        show_students(students)
    elif command == "save":
        save_students(students)
    elif command == "quit":
        save_students(students)
        print("Saved and closing. See you next time")
        break
    else:
        print("Not a valid command, try add, view, save, or quit\n")
